{
  "Repository": {
    "Root": ".",
    "StandardsFiles": [],
    "AllowedRoots": [
      "."
    ],
    "AllowedFiles": [],
    "ExcludedGlobs": [
      ".git/**",
      "**/bin/**",
      "**/obj/**",
      "**/node_modules/**",
      "**/packages/**",
      "**/.vs/**",
      "**/.vscode/**",
      "**/vscode/**"
    ],
    "MaximumReadBytes": 1048576,
    "MaximumSearchResults": 200,
    "GitProcessTimeoutSeconds": 30,
    "BuildProcessTimeoutSeconds": 900,
    "Builds": [
      {
        "Name": "legacy-oembed-release",
        "Kind": "msbuild",
        "WorkingDirectory": ".",
        "Executable": "MSBuild.exe",
        "Arguments": [
          "WillStrohl.API.oEmbed.sln",
          "/m",
          "/p:Configuration=Release"
        ]
      }
    ]
  }
}
